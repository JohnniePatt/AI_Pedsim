{
  "epochs": 50,
  "batch_size": 8,
  "learning_rate": 0.0002,
  "image_size": 256,
  "latent_dim": 32,
  "base_filters": 32,
  "dropout": 0.1,
  "use_cudnn": false,
  "target_representation": "colorjet",
  "target_channels": 3,
  "metric_mode": "rgb",
  "l1_loss_weight": 1.0,
  "mse_loss_weight": 0.25,
