{
  "method": {
    "id": "Method_XGBoost",
    "display_name": "XGBoost",
    "implementation": "vanilla_gbtree_independent_targets"
  },
  "data": {
    "data_estimate_root": "../../../Dataset/Data_Estimate_2",
    "dataset_id": "data_estimate_2_housegan_canonical_imagebase_split_v1",
    "filter_status": "success",
    "expected_rows": {
      "train": 2603,
      "val": 439,
      "test": 862
    },
    "expected_plans": {
      "train": 412,
      "val": 60,
      "test": 117
    }
  },
  "features": {
    "numeric": [
      "computed_agents",
      "topology_hop_distance",
      "topology_centerline_distance_m",
      "straight_distance_m",
      "detour_ratio",
      "distance_gap_m",
      "number_of_rooms_between_A_B",
      "door_count_between_A_B",
      "min_door_width_between_A_B",
      "walkable_area_near_path",
      "bottleneck_score",
      "agent_density_near_path",
      "area_per_agent",
      "door_pressure_per_agent"
