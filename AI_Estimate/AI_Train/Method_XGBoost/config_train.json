    "categorical": ["variant_id"],
    "target": ["min_agent_time_s", "mean_agent_time_s", "max_agent_time_s"],
    "input_scaling": "none",
    "target_transform": "log1p",
    "enforce_target_order": false
  },
  "model": {
    "booster": "gbtree",
    "objective": "reg:squarederror",
    "n_estimators": 500,
    "learning_rate": 0.05,
    "max_depth": 6,
    "min_child_weight": 1.0,
    "subsample": 1.0,
    "colsample_bytree": 1.0,
    "reg_alpha": 0.0,
    "reg_lambda": 1.0,
    "tree_method": "hist",
    "n_jobs": -1
  },
  "train": {
    "random_seed": 42,
    "smoke_test": false,
    "early_stopping_rounds": 30,
    "eval_metric": "rmse",
    "verbose": false
  },
  "evaluation": {
    "split": "test",
    "protocol_version": "travel_time_v1"
  },
  "output": {
    "root": "../../AI_result/Method_XGBoost/outputs",
    "run_name": "auto"
  }
